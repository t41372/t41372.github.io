---
import BaseLayout from '../layouts/BaseLayout.astro'
import Localized from '../components/Localized.astro'
import ProjectCard from '../components/projects/ProjectCard'
import { projects } from '../data/projects'
---

<BaseLayout
  title="Projects — Yi-Ting Chiu"
  description="Projects created and maintained by Yi-Ting Chiu: Open-LLM-VTuber, PathKeep, Standard ASR, and more."
  active="projects"
>
  <main class="mx-auto w-full max-w-6xl px-6 pb-24 pt-32 md:px-8">
    <div data-page-intro class="mb-14 flex flex-col gap-3">
      <span class="font-mono text-xs font-medium uppercase tracking-[0.3em] text-aurora">
        {'// projects'}
      </span>
      <h1 class="font-mono text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
        <Localized en="Things I work on" zh="我在做的项目" />
      </h1>
      <!-- <p class="max-w-xl text-pretty text-muted">
        Creator &amp; maintainer. These are the ones I&apos;m most serious about right now.
      </p> -->
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((p, i) => <ProjectCard {...p} index={i} client:visible />)}
    </div>

    <div data-page-tail class="mt-14">
      <a
        href="https://github.com/t41372"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-aurora"
      >
        <Localized en="more on github" zh="更多项目在 GitHub" />
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </main>
</BaseLayout>
