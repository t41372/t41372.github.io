---
import { Card } from '../../components/vendor/card'
import BaseLayout from '../../layouts/BaseLayout.astro'
import TagPill from '../../components/TagPill.astro'
import Localized from '../../components/Localized.astro'
import { formatDate } from '../../lib/format'
import { getBlogPosts, entryLang, type BlogEntry } from '../../lib/blog'

const posts = await getBlogPosts()
const hasBilingual = posts.some((p) => p.secondary)
---

<BaseLayout title="Blog — Yi-Ting Chiu" description="Writings by Yi-Ting Chiu." active="blog">
  <main class="mx-auto w-full max-w-3xl px-6 pb-24 pt-32 md:px-8">
    <div data-page-intro class="mb-12 flex flex-col gap-3">
      <div class="flex items-center justify-between gap-4">
        <span class="font-mono text-xs font-medium uppercase tracking-[0.3em] text-aurora">
          {'// blog'}
        </span>
        {
          hasBilingual && (
            <div
              data-blog-lang-toggle
              role="group"
              aria-label="Reading language"
              class="flex items-center gap-2 font-mono text-xs"
            >
              <button
                type="button"
                data-lang="en"
                aria-pressed="true"
                class="text-foreground transition-colors hover:text-aurora"
              >
                EN
              </button>
              <span class="text-muted-dark" aria-hidden="true">
                /
              </span>
              <button
                type="button"
                data-lang="zh"
                aria-pressed="false"
                class="text-muted transition-colors hover:text-aurora"
              >
                中文
              </button>
            </div>
          )
        }
      </div>
      <h1 class="font-mono text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
        <Localized en="Writings" zh="文章" />
      </h1>
      <p class="text-muted"><Localized en="Notes on things I build, break, and occasionally fix." zh="记录我做过的东西、踩过的坑，还有偶尔修好的问题。" /></p>
    </div>

    {
      posts.length === 0 ? (
        <p class="font-mono text-muted"><Localized en="Nothing here yet. Soon." zh="这里还没有文章，敬请期待。" /></p>
      ) : (
        <ul class="flex flex-col gap-4">
          {
            posts.map(({ slug, primary, secondary }) => {
              const en = [primary, secondary].find((e) => e && entryLang(e) === 'en')
              const zh = [primary, secondary].find((e) => e && entryLang(e) === 'zh')
              const hrefOf = (e: BlogEntry) =>
                e === primary ? `/blog/${slug}` : `/blog/${slug}/${entryLang(e)}`
              return (
                <li>
                  <Card data-blog-card={slug} className="gap-0 rounded-2xl border-white/10 bg-surface/50 py-0 shadow-none glass-surface transition-colors hover:border-white/20 hover:bg-surface/70">
                  <a
                    data-blog-copy
                    href={`/blog/${slug}`}
                    class="group flex flex-col gap-3 rounded-2xl p-6"
                    data-bilingual={secondary ? '' : undefined}
                    data-href-en={en ? hrefOf(en) : undefined}
                    data-href-zh={zh ? hrefOf(zh) : undefined}
                  >
                    <div class="flex items-baseline justify-between gap-3">
                      <h2
                        data-card-title
                        class="min-w-0 font-mono text-lg font-semibold text-foreground transition-colors group-hover:text-aurora"
                      >
                        <Localized en={en?.data.title ?? primary.data.title} zh={zh?.data.title ?? primary.data.title} />
                      </h2>
                      <time
                        datetime={primary.data.pubDate.toISOString()}
                        class="shrink-0 whitespace-nowrap font-mono text-xs text-muted-dark"
                      >
                        <Localized en={formatDate(primary.data.pubDate)} zh={formatDate(primary.data.pubDate, 'short', 'zh')} />
                      </time>
                    </div>
                    {/* Keep the description slot when either translation supplies it. */}
                    {(primary.data.description || secondary?.data.description) && (
                      <p data-card-desc class="text-pretty text-sm leading-relaxed text-muted">
                        <Localized en={en?.data.description ?? primary.data.description ?? ''} zh={zh?.data.description ?? primary.data.description ?? ''} />
                      </p>
                    )}
                    {(primary.data.tags.length > 0 || secondary) && (
                      <div class="mt-1 flex flex-wrap items-center gap-2">
                        {primary.data.tags.map((tag) => (
                          <TagPill tag={tag} />
                        ))}
                        {secondary && (
                          <span class="font-mono text-xs text-muted-dark">
                            {entryLang(primary) === 'en' ? 'EN · 中文' : '中文 · EN'}
                          </span>
                        )}
                      </div>
                    )}
                  </a>
                  </Card>
                </li>
              )
            })
          }
        </ul>
      )
    }
  </main>
</BaseLayout>
